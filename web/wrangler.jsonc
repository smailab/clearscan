// Cloudflare Workers 배포 설정 — Next.js 서버(OpenNext) + D1 예약 저장소
// 배포: npm run deploy:cf   /  DB 테이블 적용: npm run db:migrate
{
  "name": "clearscan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clearscan",
      "database_id": "24b4caa2-9b75-4f97-8fad-cf4d488f243e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
