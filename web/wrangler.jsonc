// Cloudflare Workers 정적 사이트 배포 설정 (npm run deploy:cf)
// 정적 빌드 결과(out/)를 그대로 올린다 — 서버 기능(예약 API, 관리자)은 포함되지 않음
{
  "name": "clearscan",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
