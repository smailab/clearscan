{
  "name": "clearscan-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "deploy:cf": "wrangler d1 migrations apply clearscan --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:migrate": "wrangler d1 migrations apply clearscan --remote",
    "db:migrate:local": "wrangler d1 migrations apply clearscan --local",
    "admin:create": "node scripts/create-admin.mjs",
    "deploy:oci": "bash deploy/oci/deploy.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
